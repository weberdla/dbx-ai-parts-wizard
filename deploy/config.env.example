# Copy to deploy/config.env and fill in. deploy/config.env is gitignored.

# Databricks CLI profile for the target workspace (~/.databrickscfg).
DATABRICKS_PROFILE=

# Existing Unity Catalog catalog you can create a schema in, and the schema to create.
CATALOG=
SCHEMA=ai_parts_wizard

# SQL warehouse id (serverless recommended) for the Genie space and dashboard.
WAREHOUSE_ID=

# Workspace folder for notebooks, app source, Genie space and dashboard.
# Leave blank to use /Workspace/Users/<you>/ai_parts_wizard.
WORKSPACE_DIR=

# Lakebase Autoscaling project and serving database (created if missing).
LAKEBASE_PROJECT=ai-parts-wizard
PGDATABASE=apw

# Databricks App name (lowercase letters, numbers, hyphens).
APP_NAME=ai-parts-wizard

# Optional: Vector Search endpoint for the online "find similar" index (deploy.sh vector-search).
VS_ENDPOINT=apw-vs
